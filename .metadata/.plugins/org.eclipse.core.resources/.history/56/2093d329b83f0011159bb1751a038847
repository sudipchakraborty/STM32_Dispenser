#include "MG996R.h"
#include "main.h"
//______________________________________________________________________________

MG996R::MG996R(TIM_HandleTypeDef* timer, uint32_t ch)
{
    htim = timer;
    channel = ch;
}

//______________________________________________________________________________

void MG996R::init()
{
    HAL_TIM_PWM_Start(htim, channel);
}

//______________________________________________________________________________

void MG996R::start()
{
    HAL_TIM_PWM_Start(htim, channel);
}

//______________________________________________________________________________

void MG996R::stop()
{
    HAL_TIM_PWM_Stop(htim, channel);
}

//______________________________________________________________________________

// Convert microseconds → timer ticks
uint32_t MG996R::usToTicks(uint16_t us)
{
    // If timer runs at 1 MHz → 1 tick = 1 us
    // Otherwise adjust this value
    return (us * timerClockMHz);
}

//______________________________________________________________________________

void MG996R::setPulseRange(uint16_t min_us, uint16_t max_us)
{
    minPulse_us = min_us;
    maxPulse_us = max_us;
}

//______________________________________________________________________________

void MG996R::setAngle(float angle)
{
    if(angle < 0) angle = 0;
    if(angle > 180) angle = 180;

    uint16_t pulse_us = minPulse_us +
        (angle / 180.0f) * (maxPulse_us - minPulse_us);

    uint32_t ticks = usToTicks(pulse_us);

    __HAL_TIM_SET_COMPARE(htim, channel, ticks);

    currentAngle = angle;
}

//______________________________________________________________________________

void MG996R::moveFast(float angle)
{
    setAngle(angle);
}

//______________________________________________________________________________

void MG996R::moveTo(float targetAngle, uint8_t step, uint16_t delayMs)
{
    if(targetAngle < 0) targetAngle = 0;
    if(targetAngle > 180) targetAngle = 180;

    if(currentAngle < targetAngle)
    {
        for(float a = currentAngle; a <= targetAngle; a += step)
        {
            setAngle(a);
            HAL_Delay(delayMs);
        }
    }
    else
    {
        for(float a = currentAngle; a >= targetAngle; a -= step)
        {
            setAngle(a);
            HAL_Delay(delayMs);
        }
    }

    currentAngle = targetAngle;
}

//______________________________________________________________________________

void MG996R::open(float angle)
{
    moveTo(angle, 1, 15);
}

//______________________________________________________________________________

void MG996R::close()
{
    moveTo(0, 1, 15);
}

//______________________________________________________________________________

void MG996R::fastClose()
{
    setAngle(0);
}
