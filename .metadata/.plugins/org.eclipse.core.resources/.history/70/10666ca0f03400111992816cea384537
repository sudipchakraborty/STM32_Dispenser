bool HX711::GetWeight(long &value)
{
    long raw;

    if (ReadRaw(raw))
    {
        // === Updated calibration (based on your new data) ===
        const long OFFSET = 1660567;   // 0g value
        const long SCALE  = 1198;      // ADC per gram

        // Apply calibration with rounding
        long weight = (raw - OFFSET + (SCALE / 2)) / SCALE;

        // Dead zone ±2g
        if (weight < 2 && weight > -2)
            weight = 0;

        value = weight;
        return true;
    }

    return false;
}
//____________________________________________________________________________________________________________________________
long HX711::Get_Raw_Avj_Value()
{
	 long value;
    // Shift buffer left
    for(int i = 0; i < BUFFER_SIZE - 1; i++)
    {
        _buffer[i] = _buffer[i + 1];
    }

    // Insert new value at end
	if(ReadRaw(value))
	{
		_buffer[BUFFER_SIZE - 1] =value;
	}

    // Calculate average
    long sum = 0;
    for(int i = 0; i < BUFFER_SIZE; i++)
    {
        sum += _buffer[i];
    }

    long average = sum / BUFFER_SIZE;
    return average;
}
//____________________________________________________________________________________________________________________________
bool HX711::ReadRaw(long &value)
{
    uint32_t timeout = HAL_GetTick();

    // Wait for DOUT LOW (data ready)
    while (HAL_GPIO_ReadPin(_dout_port, _dout_pin))
    {
        if ((HAL_GetTick() - timeout) > 200)
            return false;
    }

    __disable_irq();   // prevent timing disturbance

    uint32_t data = 0;

    for (int i = 0; i < 24; i++)
    {
        // SCK HIGH
        HAL_GPIO_WritePin(_sck_port, _sck_pin, GPIO_PIN_SET);

        // 🔥 stable delay (~1us depending on MCU speed)
        for (volatile int d = 0; d < 60; d++);

        data = data << 1;

        // Read bit
        if (HAL_GPIO_ReadPin(_dout_port, _dout_pin))
            data++;

        // SCK LOW
        HAL_GPIO_WritePin(_sck_port, _sck_pin, GPIO_PIN_RESET);

        for (volatile int d = 0; d < 60; d++);
    }

    // 25th pulse → Gain = 128
    HAL_GPIO_WritePin(_sck_port, _sck_pin, GPIO_PIN_SET);
    for (volatile int d = 0; d < 60; d++);
    HAL_GPIO_WritePin(_sck_port, _sck_pin, GPIO_PIN_RESET);

    __enable_irq();

    // 🔥 Sign extend 24-bit to 32-bit
    if (data & 0x800000)
        data |= 0xFF000000;

    value = (int32_t)data;

    return true;
}
//____________________________________________________________________________________________________________________________
long HX711::Get_Raw() {

    long count = 0;
    uint32_t timeout = HAL_GetTick();

    // Wait for DOUT to go low (Data Ready)
    while (HAL_GPIO_ReadPin(_dout_port, _dout_pin)) {
        if ((HAL_GetTick() - timeout) > 100) return false;
    }

    // Pulse SCK 24 times to read 24-bit data
    for (int i = 0; i < 24; i++) {
        HAL_GPIO_WritePin(_sck_port, _sck_pin, GPIO_PIN_SET);
        HAL_Delay(1);
        count <<= 1;
        HAL_GPIO_WritePin(_sck_port, _sck_pin, GPIO_PIN_RESET);
//        HAL_Delay(1);

        if (HAL_GPIO_ReadPin(_dout_port, _dout_pin)) count++;
    }

    // 25th pulse sets gain to 128 for next read
    HAL_GPIO_WritePin(_sck_port, _sck_pin, GPIO_PIN_SET);
//    HAL_Delay(1);
    HAL_GPIO_WritePin(_sck_port, _sck_pin, GPIO_PIN_RESET);
//    HAL_Delay(1);

    // Sign extend for 24-bit negative numbers
    if (count & 0x800000) count |= ~0xFFFFFF;
    return count;
}
//____________________________________________________________________________________________________________________________
void HX711::TestSCK(uint16_t delayMs)
{
    while (1)
    {
        // HIGH
        HAL_GPIO_WritePin(_sck_port, _sck_pin, GPIO_PIN_SET);
        HAL_Delay(delayMs);

        // LOW
        HAL_GPIO_WritePin(_sck_port, _sck_pin, GPIO_PIN_RESET);
        HAL_Delay(delayMs);
    }
}
