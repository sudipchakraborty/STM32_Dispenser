#include <stdlib.h>
#include "Prj_utils.hpp"
#include "Enum.hpp"

const char* GetRWString(uint8_t rw)
{
    switch (rw)
    {
        case 0: return "READ";
        case 1: return "WRITE";
        case 2: return "EXECUTE";
        default: return "INVALID";
    }
}
