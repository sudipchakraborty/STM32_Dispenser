void process_command(Packet_t pkt)
{
	uint16_t val;
	uint16_t temp, Previous_Weight, Current_Weight;

	uint16_t diff;

	switch(pkt.rw)
	{
	case Operation::read:

		break;
	////////////////////////
	case Operation::write:

		if(pkt.command==5)
		{
			servo1.moveFast(90);
			Delay::ms(3000);
			servo1.fastClose();
		}

		if(pkt.command==6)
		{
			servo1.fastClose();
		}

		break;
	///////////////////////
	case Operation::execute:

		if(pkt.command==5) // 5: return "Open_Valve,";
		{
			uint16_t values[64];
			size_t count = Packet_GetUint16Array(&pkt, values, 64);
			debug.print("Open command received:5 \r\n");
			debug.print("Rotation angle:%d \r\n",values[0]);
			servo1.moveFast(values[0]);
		}

		if(pkt.command==6) // 5: return "Open_Valve,";
		{
			debug.print("Close command received:6 \r\n");
			servo1.fastClose();
		}

		if(pkt.command==2) // "Dispense_Weight_Based";
		{
			debug.print("Dispense_Weight_Based command received:2 \r\n");
			val=ReadUInt16_BE(pkt.data);
			DispenseWeight(val, 90);
		}

		break;
	///////////////////////
	default:
		break;
	//////////////////////
	}
}


//______________________________________________________________________________________________________________________
char DispenseWeight(long target_grams, int OpenInDeg)
{
    float InitialWeight = 0;
    float RunningtWeight = 0;
    int TimeOutCount = 0;

    InitialWeight = hx.GetWeight();
    float TargetWeight = InitialWeight - target_grams;

    debug.print("IW= %ld,", (long)InitialWeight);
    debug.print("TW= %ld\r\n", (long)TargetWeight);

    Delay::ms(500);

    // Open valve
    servo1.moveFast(OpenInDeg);
    debug.print("Valve Open(Deg.): %d\r\n", OpenInDeg);

    while (1)
    {
        RunningtWeight = hx.GetWeight();

        debug.print("IW= %ld,", (long)InitialWeight);
        debug.print("RW= %ld,", (long)RunningtWeight);
        debug.print("TW= %ld\r\n", (long)TargetWeight);

        // ✔ 1. Check valve opening (weight should decrease)
        float diff = std::fabs(InitialWeight - RunningtWeight);

        if (diff < WEIGHT_THRESHOLD)
        {
            TimeOutCount++;
            if (TimeOutCount > TIMEOUT_LIMIT)
            {
                debug.print("Error: Valve Opening Error..\r\n");
                servo1.fastClose();
                return -1;
            }
        }
        else
        {
            TimeOutCount = 0;
        }

        // ✔ 2. TARGET REACHED → CLOSE VALVE
        if (RunningtWeight <= TargetWeight)
        {
            debug.print("Target reached. Closing valve...\r\n");
            servo1.fastClose();
            return 0;
        }

//        Delay::ms(500);
    }
}
